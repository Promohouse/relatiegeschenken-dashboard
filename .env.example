# ---------------------------------------------------------------------------
# Relatiegeschenken Hub - voorbeeldomgeving
# Kopieer naar .env en vul in. .env staat in .gitignore.
# ---------------------------------------------------------------------------

# Database -------------------------------------------------------------------
# Eigen database op de bestaande lokale PostgreSQL 16 (poort 5432).
# Draait naast promohouse / voetbalticketskopen zonder die te raken.
# Gebruik een EIGEN rol, geen superuser: dan kan een fout in dit project
# technisch niet bij de databases van andere projecten.
DATABASE_URL="postgresql://relatiegeschenken:WACHTWOORD@localhost:5432/relatiegeschenken_dev?schema=public"
TEST_DATABASE_URL="postgresql://relatiegeschenken:WACHTWOORD@localhost:5432/relatiegeschenken_test?schema=public"

# Veiligheidsslot: destructieve commando's (prisma migrate reset) weigeren
# te draaien als de databasenaam niet met dit voorvoegsel begint.
DB_NAME_PREFIX="relatiegeschenken_"

# Poorten --------------------------------------------------------------------
# 3000 is op deze machine al in gebruik door een ander project.
API_PORT=3101
WEB_PORT=3100
WEB_BASE_URL="http://localhost:3100"
API_BASE_URL="http://localhost:3101"

# Auth -----------------------------------------------------------------------
AUTH_SECRET="genereer-met: openssl rand -base64 32"
SESSION_MAX_AGE_DAYS=14
MFA_ISSUER="Relatiegeschenken Hub"

# Bestandsopslag -------------------------------------------------------------
# local = LocalDiskAdapter. Later: s3 via dezelfde StoragePort.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH="./storage"

# Achtergrondtaken -----------------------------------------------------------
# BullMQ op Valkey (ADR-0009). Valkey kan op deze machine met andere projecten
# gedeeld worden, daarom een eigen databasenummer en keyprefix.
VALKEY_URL="redis://localhost:6379"
VALKEY_DB=3
VALKEY_TEST_DB=4
QUEUE_PREFIX="rgh"
JOBS_ENABLED=true

# Demodata -------------------------------------------------------------------
# Toont een waarschuwingsbalk in de UI zolang er demodata in de database staat.
DEMO_MODE=true

# Leverancierskoppelingen ----------------------------------------------------
# Echte credentials horen NIET hier: die staan versleuteld in de database
# (tabel SupplierConnection). Alleen de sleutel om te ontsleutelen staat hier.
CONNECTOR_SECRET_KEY="genereer-met: openssl rand -base64 32"
