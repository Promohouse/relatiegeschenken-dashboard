{
  "name": "@rgh/db",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "node ../../scripts/db-guard.mjs && dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "node ../../scripts/db-guard.mjs && dotenv -e ../../.env -- prisma migrate deploy",
    "reset": "node ../../scripts/db-guard.mjs --destructive && dotenv -e ../../.env -- prisma migrate reset",
    "seed": "node ../../scripts/db-guard.mjs && dotenv -e ../../.env -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "test": "node ../../scripts/prepare-test-db.mjs && vitest run"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@rgh/contracts": "*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2"
  }
}
