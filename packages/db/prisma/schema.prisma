// ---------------------------------------------------------------------------
// Relatiegeschenken Hub - kernschema (stap 1a)
//
// Conventies:
// - Tabelnamen snake_case via @@map; kolomnamen blijven camelCase.
//   Reden: "order" is een SQL-sleutelwoord, en de importpijplijn gebruikt
//   later ruwe SQL met bulk-COPY waarin leesbare tabelnamen helpen.
// - Bedragen: NUMERIC. Eenheidsprijzen (14,4), totalen (14,2). Nooit float.
// - isDemo markeert gezaaide demodata, zodat die veilig op te ruimen is.
// - Auth-tabellen (sessies, MFA-secrets) komen in stap 3 van de gekozen
//   bibliotheek en koppelen aan User. Niet hier verzinnen.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

// Connectie-URL's staan vanaf Prisma 7 in prisma.config.ts, niet hier.
datasource db {
  provider = "postgresql"
}

// --- Opsommingen -----------------------------------------------------------

enum AddressType {
  INVOICE
  DELIVERY
}

/// Offertestatus. Een offerte heeft een eigen statusreeks: een order kan niet
/// "verlopen" of "wijziging gevraagd" zijn. Zie ADR-0007.
enum QuoteStatus {
  DRAFT
  READY_TO_SEND
  SENT
  AWAITING_CUSTOMER
  CHANGES_REQUESTED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum QuoteDecision {
  ACCEPTED
  REJECTED
  CHANGES_REQUESTED
}

/// Hoofdstatus van de order. Drukproef-, inkoop- en logistieke status staan
/// per orderregel, omdat een order meerdere leveranciers en drukproeven heeft.
enum OrderStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FinanceStatus {
  NOT_INVOICEABLE
  READY_TO_INVOICE
  INVOICED
  PAID
}

enum ProofStatus {
  NOT_REQUIRED
  REQUESTED
  RECEIVED
  SENT_TO_CUSTOMER
  APPROVED
  CHANGES_REQUESTED
}

enum PurchaseStatus {
  NOT_ORDERED
  ORDERED
  CONFIRMED
  IN_PRODUCTION
  READY
}

/// Logistieke status van een orderregel: uitgaand, richting de klant.
/// Inkomende ontvangsten van leveranciers staan in goods_receipts en in
/// PurchaseStatus; die twee niet door elkaar halen.
enum LogisticsStatus {
  NONE
  EXPECTED
  PREPARED
  SHIPPED
  PARTIALLY_DELIVERED
  DELIVERED
}

/// Binnenland, intracommunautair (btw verlegd naar afnemer), export buiten EU,
/// en verlegging binnen Nederland.
enum VatRegime {
  DOMESTIC
  EU_REVERSE_CHARGE
  EXPORT
  DOMESTIC_SHIFTED
}

enum StatusDimension {
  MAIN
  PROOF
  PURCHASE
  LOGISTICS
  FINANCE
}

enum OrderEventType {
  REQUEST_RECEIVED
  QUOTE_CREATED
  QUOTE_SENT
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  ORDER_CREATED
  PROOF_REQUESTED
  PROOF_RECEIVED
  PROOF_SENT_TO_CUSTOMER
  PROOF_APPROVED
  PROOF_CHANGES_REQUESTED
  ORDERED_AT_SUPPLIER
  SUPPLIER_CONFIRMED
  EXPECTED_DELIVERY_KNOWN
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  PACKING_SLIP_ADDED
  READY_TO_INVOICE
  INVOICED
  COMPLETED
  NOTE_ADDED
  DOCUMENT_ADDED
  TASK_CREATED
  OWNER_CHANGED
  STATUS_CHANGED
}

enum DocumentCategory {
  QUOTE
  ORDER_CONFIRMATION
  PROOF
  SUPPLIER_CONFIRMATION
  PURCHASE_ORDER
  PURCHASE_INVOICE
  PACKING_SLIP
  SALES_INVOICE
  OTHER
}

enum DocumentVisibility {
  INTERNAL
  CUSTOMER
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  EXPORT
  LOGIN
  LOGIN_FAILED
  LOGOUT
}

/// Herkomst van een veldwaarde. Zie ADR-0004: een handmatig gezette waarde
/// wordt door geen enkele leveranciersimport overschreven.
enum FieldSource {
  SUPPLIER
  MANUAL
}

enum MediaRole {
  MAIN
  GALLERY
  ATMOSPHERE
  PRINT_TEMPLATE
  DATASHEET
}

// --- Identiteit en rechten -------------------------------------------------

/// Lichte of donkere weergave van het dashboard.
enum ThemePreference {
  /// Volgt de instelling van het besturingssysteem.
  SYSTEM
  LIGHT
  DARK
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique
  name        String
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  // --- Velden van better-auth (ADR-0012) ---
  // better-auth adresseert via de Prisma-adapter dit model rechtstreeks, dus
  // er is één gebruikerstabel in plaats van twee die synchroon moeten blijven.
  // Deze namen liggen vast door de bibliotheek.
  emailVerified    Boolean  @default(false)
  image            String?
  /// Vervangt het eerdere mfaEnabled: één vlag, beheerd door de tweefactor-plugin.
  twoFactorEnabled Boolean? @default(false)

  /// Lichte of donkere weergave. Een persoonlijke voorkeur, geen
  /// systeeminstelling: wie 's avonds werkt wil iets anders dan wie overdag
  /// werkt, en dat verschilt per medewerker.
  themePreference ThemePreference @default(SYSTEM)

  /// Gevuld bij een klantgebruiker (portaal). Leeg bij een interne medewerker.
  /// De Prisma-extensie dwingt af dat portaalsessies alleen eigen data zien.
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles                   UserRole[]
  ownedOrders             Order[]           @relation("OrderOwner")
  orderEvents             OrderEvent[]
  auditLogs               AuditLog[]
  tasksAssigned           Task[]            @relation("TaskAssignee")
  tasksCreated            Task[]            @relation("TaskCreator")
  documents               Document[]
  documentVersion         DocumentVersion[]
  proofApprovals          ProofApproval[]
  reviewedChanges         StagedChange[]
  invoicesContentApproved PurchaseInvoice[] @relation("InvoiceContentApprover")
  invoicesFinanceApproved PurchaseInvoice[] @relation("InvoiceFinanceApprover")

  ownedQuotes          Quote[]         @relation("QuoteOwner")
  createdQuoteVersions QuoteVersion[]
  quoteApprovals       QuoteApproval[]

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]

  @@index([customerId])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  name        String
  description String?
  /// Systeemrollen kunnen niet verwijderd worden.
  isSystem    Boolean @default(false)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

/// Permissies zijn "module:actie", bijvoorbeeld orders:approve. Ze staan in de
/// database zodat rechten configureerbaar zijn zonder code te wijzigen.
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  module      String
  action      String
  description String?

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// --- CRM -------------------------------------------------------------------

model Customer {
  id     String @id @default(uuid()) @db.Uuid
  /// Klantnummer uit NumberSequence. Formaat instelbaar, reeks voortzetbaar.
  number String @unique

  name      String
  vatNumber String?
  email     String?
  phone     String?
  website   String?
  /// Interne opmerkingen, nooit zichtbaar in het klantportaal.
  notes     String?
  isActive  Boolean @default(true)

  /// Welke betalingsvoorwaarde geldt. Leeg betekent: de standaard uit
  /// payment_terms. Restrict, want een voorwaarde die in gebruik is mag niet
  /// onder een klant vandaan verdwijnen.
  paymentTermId String?      @db.Uuid
  paymentTerm   PaymentTerm? @relation(fields: [paymentTermId], references: [id], onDelete: Restrict)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts        ContactPerson[]
  addresses       Address[]
  agreements      CustomerAgreement[]
  priceAgreements CustomerPriceAgreement[]
  orders          Order[]
  documents       Document[]
  tasks           Task[]
  portalUsers     User[]
  channels        ShopChannel[]
  priceRules      PriceRule[]

  quotes Quote[]

  @@index([name])
  @@index([paymentTermId])
  @@map("customers")
}

/// Betalingsvoorwaarde: een gedeelde lijst, niet een los veld per klant.
/// Anders staan er na een jaar vijftien varianten van "30 dagen".
model PaymentTerm {
  id   String @id @default(uuid()) @db.Uuid
  /// Stabiele sleutel voor code en koppelingen (net_30, eom_30, prepaid_50).
  key  String @unique
  name String

  /// Dagen na de factuurdatum, of na de laatste dag van de factuurmaand als
  /// `endOfMonth` aan staat.
  days       Int     @default(30)
  endOfMonth Boolean @default(false)

  /// Deel dat vooraf betaald moet zijn. Relevant bij nieuwe klanten en grote
  /// orders: er wordt pas ingekocht als de aanbetaling binnen is.
  prepaymentPercent Decimal? @db.Decimal(5, 2)

  /// Tekst zoals die op de factuur komt.
  invoiceText String?

  /// Hoogstens een rij met isDefault; een partiele unieke index dwingt dat af.
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  sort      Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]

  @@index([isActive, sort])
  @@map("payment_terms")
}

/// Een met de klant afgesproken bedrag per stuk, vanaf een aantal.
///
/// Staat los van `price_rules`: die rekenen een marge over de inkoopprijs,
/// dit is een toegezegd bedrag. Daarom gaat een afspraak in de prijsengine
/// altijd voor op een regel, ongeacht `priority`.
model CustomerPriceAgreement {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Restrict: een product waarover een prijsafspraak loopt verdwijnt niet
  /// stil uit de catalogus.
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  minQuantity Int     @default(1)
  unitPrice   Decimal @db.Decimal(14, 4)
  /// Waar de afspraak uit komt: een mailwisseling, een jaarafspraak, een tender.
  note        String?

  validFrom DateTime?
  validTo   DateTime?
  isActive  Boolean   @default(true)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, productId, minQuantity])
  @@index([customerId, isActive])
  @@index([productId])
  @@map("customer_price_agreements")
}

model ContactPerson {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String?
  phone     String?
  jobTitle  String?
  isPrimary Boolean @default(false)
  isActive  Boolean @default(true)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders         Order[]
  proofApprovals ProofApproval[]

  quotes         Quote[]
  quoteApprovals QuoteApproval[]

  @@index([customerId])
  @@map("contact_persons")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type        AddressType
  /// Vrij label, bijvoorbeeld "Hoofdkantoor" of "Vestiging Zwolle".
  label       String?
  attention   String?
  street      String
  houseNumber String?
  postalCode  String
  city        String
  country     String      @default("NL")
  isDefault   Boolean     @default(false)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceOrders  Order[] @relation("OrderInvoiceAddress")
  deliveryOrders Order[] @relation("OrderDeliveryAddress")

  invoiceQuotes  Quote[] @relation("QuoteInvoiceAddress")
  deliveryQuotes Quote[] @relation("QuoteDeliveryAddress")

  shipments Shipment[] @relation("ShipmentDeliveryAddress")

  @@index([customerId, type])
  @@map("addresses")
}

model CustomerAgreement {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  title     String
  body      String
  validFrom DateTime?
  validTo   DateTime?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("customer_agreements")
}

// --- Leveranciers ----------------------------------------------------------

model Supplier {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique
  name      String
  /// PSI-nummer, indien bekend.
  psiNumber String?
  email     String?
  phone     String?
  website   String?
  notes     String?
  isActive  Boolean @default(true)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts         SupplierContact[]
  productSuppliers ProductSupplier[]
  orderLines       OrderLine[]
  mediaAssets      MediaAsset[]
  connections      SupplierConnection[]
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  priceRules       PriceRule[]

  quoteItems QuoteItem[]

  shipments Shipment[]

  @@map("suppliers")
}

model SupplierContact {
  id         String   @id @default(uuid()) @db.Uuid
  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String?
  phone     String?
  jobTitle  String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@map("supplier_contacts")
}

// --- Eigen catalogus -------------------------------------------------------
// Dit is de gecureerde laag. Ruwe leveranciersdata landt in de stagingtabellen
// uit stap 1b en komt hier alleen via mapping en goedkeuring terecht.

model ProductCategory {
  id       String            @id @default(uuid()) @db.Uuid
  parentId String?           @db.Uuid
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductCategory[] @relation("CategoryTree")

  name String
  slug String @unique
  /// Volledig pad, bijvoorbeeld "drinkware/thermosbekers". Voor snelle filters.
  path String
  sort Int    @default(0)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   Product[]
  priceRules PriceRule[]

  @@index([parentId])
  @@index([path])
  @@map("product_categories")
}

model Product {
  id            String  @id @default(uuid()) @db.Uuid
  /// Eigen artikelnummer, onafhankelijk van leveranciersnummers.
  articleNumber String  @unique
  name          String
  description   String?
  brand         String?

  categoryId String?          @db.Uuid
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Productkenmerken die leveranciers aanleveren en die een klant vraagt.
  /// Allemaal optioneel: niet elke leverancier levert ze, en leeg is iets
  /// anders dan onbekend.
  material              String?
  /// Afmetingen zoals de leverancier ze schrijft, bijvoorbeeld "21X14X1,6 CM".
  dimensions            String?
  /// Landcode van herkomst, twee letters.
  countryOfOrigin       String?
  /// Goederencode voor douane en intrastat.
  commodityCode         String?
  /// Of er op bedrukt kan worden volgens de leverancier.
  printable             Boolean?
  /// Manipulatiecode van de leverancier (A-Z): bepaalt de handlingprijs per
  /// stuk bij bedrukken. Leeg betekent geen handlingkosten.
  printManipulationCode String?

  isActive Boolean @default(true)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants     ProductVariant[]
  suppliers    ProductSupplier[]
  salesTiers   SalesPriceTier[]
  printOptions ProductPrintOption[]
  media        ProductMedia[]
  fieldSources ProductFieldSource[]
  orderLines   OrderLine[]
  channelItems ChannelAssortmentItem[]
  priceRules   PriceRule[]

  priceAgreements CustomerPriceAgreement[]

  quoteItems QuoteItem[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

/// Kleur- en maatvarianten. Genormaliseerde waarden; de mapping van
/// leveranciersbenamingen ("navy", "NY", "donkerblauw") gebeurt bij import.
model ProductVariant {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku        String  @unique
  colorName  String?
  colorHex   String?
  /// Kleurcode van de leverancier, bijvoorbeeld "03". Nodig bij bestellen.
  colorCode  String?
  /// Grove kleurgroep om op te filteren: black, blue, ...
  colorGroup String?
  /// Pantone-aanduiding, als de leverancier die geeft.
  pmsColor   String?
  size       String?
  eanCode    String?
  isActive   Boolean @default(true)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderLines OrderLine[]

  quoteItems QuoteItem[]

  supplierStock SupplierStock[]

  @@index([productId])
  @@map("product_variants")
}

/// Eén product kan bij meerdere leveranciers ingekocht worden.
model ProductSupplier {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  supplierId String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  /// Artikelnummer zoals de leverancier het noemt. Sleutel bij import.
  supplierArticleNumber String
  purchasePrice         Decimal @db.Decimal(14, 4)
  currency              String  @default("EUR")
  minimumOrderQuantity  Int     @default(1)
  leadTimeDays          Int?
  /// Minimum aantal voor bedrukken bij deze leverancier. Onder dit aantal
  /// rekent hij een toeslag; die staat bij de drukprijzen als ltmCharge.
  minDecoQuantity Int?

  isPreferred           Boolean @default(false)
  isActive              Boolean @default(true)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseTiers      PurchasePriceTier[]
  orderLines         OrderLine[]
  purchaseOrderLines PurchaseOrderLine[]

  quoteItems QuoteItem[]

  @@unique([supplierId, supplierArticleNumber])
  @@index([productId])
  @@map("product_suppliers")
}

model PurchasePriceTier {
  id                String          @id @default(uuid()) @db.Uuid
  productSupplierId String          @db.Uuid
  productSupplier   ProductSupplier @relation(fields: [productSupplierId], references: [id], onDelete: Cascade)

  minQuantity Int
  unitPrice   Decimal @db.Decimal(14, 4)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([productSupplierId, minQuantity])
  @@map("purchase_price_tiers")
}

/// Verkoopstaffels. Kunnen uit de prijsengine komen of handmatig vastgezet
/// zijn; validFrom/validTo maakt een prijsverhoging vooruit klaarzetten mogelijk.
model SalesPriceTier {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  minQuantity Int
  unitPrice   Decimal   @db.Decimal(14, 4)
  validFrom   DateTime?
  validTo     DateTime?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId, minQuantity])
  @@map("sales_price_tiers")
}

/// Genormaliseerde bedrukkingstechniek: zeefdruk, tampondruk, laser, doming.
model PrintMethod {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  name        String
  description String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  productOptions ProductPrintOption[]
  printJobs      OrderLinePrintJob[]

  quoteItemPrintJobs QuoteItemPrintJob[]

  @@map("print_methods")
}

model ProductPrintOption {
  id            String      @id @default(uuid()) @db.Uuid
  productId     String      @db.Uuid
  printMethodId String      @db.Uuid
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  printMethod   PrintMethod @relation(fields: [printMethodId], references: [id], onDelete: Restrict)

  printPositionId String        @db.Uuid
  printPosition   PrintPosition @relation(fields: [printPositionId], references: [id], onDelete: Restrict)

  /// De benaming zoals de leverancier die aanlevert. De genormaliseerde
  /// positie staat in printPosition; dit veld bewaart het origineel.
  positionLabel         String?
  /// Techniekcode van de leverancier, voor het opzoeken van de drukprijs.
  supplierTechniqueCode String?
  /// Maximale bedrukmaat in millimeters, zoals de leverancier die opgeeft.
  maxPrintWidthMm       Decimal? @db.Decimal(10, 2)
  maxPrintHeightMm      Decimal? @db.Decimal(10, 2)
  maxColors             Int      @default(1)
  /// Maximale bedrukkingsafmeting, vrije tekst zoals leveranciers die geven.
  printArea             String?
  /// Instelkosten per order, los van de stuksprijs.
  setupCost             Decimal  @default(0) @db.Decimal(14, 4)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceTiers PrintPriceTier[]

  @@unique([productId, printMethodId, printPositionId])
  @@index([printPositionId])
  @@map("product_print_options")
}

/// Staffel voor bedrukkingskosten: per aantal kleuren en per aantal stuks.
/// Dit is het model waar de verschillen tussen leveranciers samenkomen.
model PrintPriceTier {
  id                   String             @id @default(uuid()) @db.Uuid
  productPrintOptionId String             @db.Uuid
  productPrintOption   ProductPrintOption @relation(fields: [productPrintOptionId], references: [id], onDelete: Cascade)

  colors      Int     @default(1)
  minQuantity Int
  unitPrice   Decimal @db.Decimal(14, 4)
  setupCost   Decimal @default(0) @db.Decimal(14, 4)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([productPrintOptionId, colors, minQuantity])
  @@map("print_price_tiers")
}

/// Gedownloade media. Leveranciers halen URL's offline; daarom nooit hotlinken.
model MediaAsset {
  id         String    @id @default(uuid()) @db.Uuid
  storageKey String    @unique
  fileName   String
  mimeType   String
  sizeBytes  Int
  checksum   String
  width      Int?
  height     Int?
  /// Oorspronkelijke URL bij de leverancier, voor herkomst en herdownload.
  sourceUrl  String?
  supplierId String?   @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  products ProductMedia[]

  @@index([checksum])
  @@map("media_assets")
}

model ProductMedia {
  productId    String     @db.Uuid
  mediaAssetId String     @db.Uuid
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  role MediaRole @default(GALLERY)
  sort Int       @default(0)

  @@id([productId, mediaAssetId])
  @@index([productId, role])
  @@map("product_media")
}

/// Veldeigendom: welk veld is door een mens gezet en mag niet overschreven
/// worden door een import. Zie ADR-0004.
model ProductFieldSource {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  field    String
  source   FieldSource @default(SUPPLIER)
  /// Expliciet slot: ook een handmatige wijziging elders mag dit niet raken.
  isLocked Boolean     @default(false)

  updatedAt DateTime @updatedAt

  @@unique([productId, field])
  @@map("product_field_sources")
}

// --- Offertes --------------------------------------------------------------
// Eigen aggregaat met onveranderlijke versies (ADR-0007). Een verzonden
// versie is niet meer te wijzigen; databasetriggers dwingen dat af, niet de
// interface. Zo ligt een digitaal klantakkoord vast aan een exacte versie.

model Quote {
  id     String @id @default(uuid()) @db.Uuid
  number String @unique

  customerId      String         @db.Uuid
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contactPersonId String?        @db.Uuid
  contactPerson   ContactPerson? @relation(fields: [contactPersonId], references: [id], onDelete: SetNull)

  ownerId String? @db.Uuid
  owner   User?   @relation("QuoteOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  invoiceAddressId  String?  @db.Uuid
  invoiceAddress    Address? @relation("QuoteInvoiceAddress", fields: [invoiceAddressId], references: [id], onDelete: SetNull)
  deliveryAddressId String?  @db.Uuid
  deliveryAddress   Address? @relation("QuoteDeliveryAddress", fields: [deliveryAddressId], references: [id], onDelete: SetNull)

  status QuoteStatus @default(DRAFT)

  /// De versie die nu geldt. Verwijst naar de laatste versie, ook als die nog
  /// een concept is.
  currentVersionId String?       @unique @db.Uuid
  currentVersion   QuoteVersion? @relation("QuoteCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  /// De versie waarop de klant akkoord heeft gegeven. Eenmaal gevuld verandert
  /// deze nooit meer; daar hangt de order aan.
  acceptedVersionId String?       @unique @db.Uuid
  acceptedVersion   QuoteVersion? @relation("QuoteAcceptedVersion", fields: [acceptedVersionId], references: [id], onDelete: SetNull)

  requestedDeliveryDate DateTime?
  reference             String?
  /// Interne opmerkingen, nooit zichtbaar in het klantportaal.
  notes                 String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions  QuoteVersion[] @relation("QuoteVersions")
  documents Document[]
  tasks     Task[]

  @@index([customerId])
  @@index([status])
  @@index([ownerId])
  @@map("quotes")
}

/// Eén versie van een offerte. Zodra `lockedAt` gevuld is, is deze rij en al
/// zijn regels onveranderlijk. Een wijziging maakt een nieuwe versie.
model QuoteVersion {
  id      String @id @default(uuid()) @db.Uuid
  quoteId String @db.Uuid
  quote   Quote  @relation("QuoteVersions", fields: [quoteId], references: [id], onDelete: Cascade)

  versionNumber Int

  validUntil DateTime?
  vatRegime  VatRegime @default(DOMESTIC)
  currency   String    @default("EUR")

  /// Totalen zijn de som van de afgeronde regelbedragen (ADR-0005).
  subtotalExclVat Decimal @default(0) @db.Decimal(14, 2)
  vatAmount       Decimal @default(0) @db.Decimal(14, 2)
  totalInclVat    Decimal @default(0) @db.Decimal(14, 2)
  purchaseTotal   Decimal @default(0) @db.Decimal(14, 2)
  marginAmount    Decimal @default(0) @db.Decimal(14, 2)

  deliveryTerms String?
  /// Tekst die de klant op de offerte ziet.
  customerNotes String?

  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  sentAt           DateTime?
  /// Gezet bij verzenden. Vanaf dat moment weigeren de triggers elke wijziging.
  lockedAt         DateTime?
  /// Controlewaarde van de PDF op het moment van vastzetten. Onderdeel van het
  /// bewijs bij een klantakkoord.
  documentChecksum String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     QuoteItem[]
  approvals QuoteApproval[]
  documents Document[]

  /// Uit één geaccepteerde versie komt nooit meer dan één order.
  order Order?

  currentOfQuote  Quote? @relation("QuoteCurrentVersion")
  acceptedOfQuote Quote? @relation("QuoteAcceptedVersion")

  @@unique([quoteId, versionNumber])
  @@index([quoteId])
  @@index([lockedAt])
  @@map("quote_versions")
}

/// Offerteregel met prijsmomentopname. Dezelfde opbouw als een orderregel,
/// zodat conversie een kopie is en geen herberekening.
model QuoteItem {
  id             String       @id @default(uuid()) @db.Uuid
  quoteVersionId String       @db.Uuid
  quoteVersion   QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  lineNumber     Int

  productId         String?          @db.Uuid
  product           Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariantId  String?          @db.Uuid
  productVariant    ProductVariant?  @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  productSupplierId String?          @db.Uuid
  productSupplier   ProductSupplier? @relation(fields: [productSupplierId], references: [id], onDelete: SetNull)
  supplierId        String?          @db.Uuid
  supplier          Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // --- Momentopname bij aanmaak ---
  productArticleNumber String?
  productName          String
  variantDescription   String?
  supplierName         String?
  description          String?

  quantity          Int
  unitSalePrice     Decimal @db.Decimal(14, 4)
  unitPurchasePrice Decimal @default(0) @db.Decimal(14, 4)
  discountPercent   Decimal @default(0) @db.Decimal(5, 2)
  setupCost         Decimal @default(0) @db.Decimal(14, 4)
  vatRate           Decimal @default(21) @db.Decimal(5, 2)

  lineSubtotalExclVat Decimal @default(0) @db.Decimal(14, 2)
  lineVatAmount       Decimal @default(0) @db.Decimal(14, 2)
  lineTotalInclVat    Decimal @default(0) @db.Decimal(14, 2)
  linePurchaseTotal   Decimal @default(0) @db.Decimal(14, 2)
  lineMarginAmount    Decimal @default(0) @db.Decimal(14, 2)

  notes String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  printJobs  QuoteItemPrintJob[]
  orderLines OrderLine[]

  @@unique([quoteVersionId, lineNumber])
  @@index([quoteVersionId])
  @@index([productId])
  @@map("quote_items")
}

model QuoteItemPrintJob {
  id          String    @id @default(uuid()) @db.Uuid
  quoteItemId String    @db.Uuid
  quoteItem   QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)

  printMethodId String?      @db.Uuid
  printMethod   PrintMethod? @relation(fields: [printMethodId], references: [id], onDelete: SetNull)

  printMethodName String
  position        String?
  colors          Int     @default(1)
  unitPrice       Decimal @default(0) @db.Decimal(14, 4)
  setupCost       Decimal @default(0) @db.Decimal(14, 4)
  notes           String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Genormaliseerde positie. Niet aangevuld voor historische, vastgezette
  /// offerteversies: daar is de tekst in `position` het vastgelegde gegeven.
  printPositionId String?        @db.Uuid
  printPosition   PrintPosition? @relation(fields: [printPositionId], references: [id], onDelete: SetNull)

  @@index([quoteItemId])
  @@map("quote_item_print_jobs")
}

/// Beslissing van de klant op één offerteversie. Append-only: een trigger
/// weigert elke wijziging en verwijdering.
model QuoteApproval {
  id             String       @id @default(uuid()) @db.Uuid
  quoteVersionId String       @db.Uuid
  quoteVersion   QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)

  decision QuoteDecision

  decidedByUserId    String?        @db.Uuid
  decidedByUser      User?          @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedByContactId String?        @db.Uuid
  decidedByContact   ContactPerson? @relation(fields: [decidedByContactId], references: [id], onDelete: SetNull)

  decidedAt DateTime @default(now())
  comment   String?

  /// Bewijsmateriaal bij het akkoord.
  ipAddress        String?
  userAgent        String?
  documentChecksum String?

  /// Sleutel "<quoteVersionId>:<decision>". Hiermee levert tweemaal klikken op
  /// akkoord één beslissing en dus nooit twee orders.
  idempotencyKey String @unique

  isDemo Boolean @default(false)

  @@index([quoteVersionId])
  @@map("quote_approvals")
}

// --- Orders ----------------------------------------------------------------
// Een order ontstaat uit een geaccepteerde offerteversie (ADR-0007) of wordt
// rechtstreeks aangemaakt. Offertes staan in hun eigen aggregaat hieronder.

model Order {
  id     String @id @default(uuid()) @db.Uuid
  number String @unique

  /// De geaccepteerde offerteversie waaruit deze order is ontstaan. Leeg bij
  /// een order die zonder offerte is aangemaakt. Eén op één: uit één
  /// geaccepteerde versie komt nooit meer dan één order.
  quoteVersionId String?       @unique @db.Uuid
  quoteVersion   QuoteVersion? @relation(fields: [quoteVersionId], references: [id], onDelete: Restrict)

  customerId      String         @db.Uuid
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contactPersonId String?        @db.Uuid
  contactPerson   ContactPerson? @relation(fields: [contactPersonId], references: [id], onDelete: SetNull)

  /// Verantwoordelijke medewerker. Orders zijn overdraagbaar; iedere
  /// wijziging komt in de tijdlijn als OWNER_CHANGED.
  ownerId String? @db.Uuid
  owner   User?   @relation("OrderOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  invoiceAddressId  String?  @db.Uuid
  invoiceAddress    Address? @relation("OrderInvoiceAddress", fields: [invoiceAddressId], references: [id], onDelete: SetNull)
  deliveryAddressId String?  @db.Uuid
  deliveryAddress   Address? @relation("OrderDeliveryAddress", fields: [deliveryAddressId], references: [id], onDelete: SetNull)

  orderDate             DateTime  @default(now())
  requestedDeliveryDate DateTime?
  expectedDeliveryDate  DateTime?

  status        OrderStatus   @default(DRAFT)
  financeStatus FinanceStatus @default(NOT_INVOICEABLE)
  vatRegime     VatRegime     @default(DOMESTIC)
  currency      String        @default("EUR")

  reference String?
  notes     String?

  /// Teller voor optimistic locking. Twee gelijktijdige wijzigingen leveren
  /// één winnaar en voor de ander een duidelijke melding.
  version Int @default(0)

  /// Totalen worden altijd server-side herberekend uit de vastgelegde
  /// regelwaarden, nooit uit de live productprijs.
  subtotalExclVat Decimal @default(0) @db.Decimal(14, 2)
  vatAmount       Decimal @default(0) @db.Decimal(14, 2)
  totalInclVat    Decimal @default(0) @db.Decimal(14, 2)
  purchaseTotal   Decimal @default(0) @db.Decimal(14, 2)
  marginAmount    Decimal @default(0) @db.Decimal(14, 2)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines     OrderLine[]
  events    OrderEvent[]
  documents Document[]
  tasks     Task[]

  shipments Shipment[]

  @@index([customerId])
  @@index([status])
  @@index([ownerId])
  @@index([orderDate])
  @@map("orders")
}

model OrderLine {
  id         String @id @default(uuid()) @db.Uuid
  orderId    String @db.Uuid
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNumber Int

  /// Herkomst: de offerteregel waaruit deze orderregel is overgenomen.
  quoteItemId String?    @db.Uuid
  quoteItem   QuoteItem? @relation(fields: [quoteItemId], references: [id], onDelete: SetNull)

  /// Teller voor optimistic locking.
  version Int @default(0)

  productId         String?          @db.Uuid
  product           Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariantId  String?          @db.Uuid
  productVariant    ProductVariant?  @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  productSupplierId String?          @db.Uuid
  productSupplier   ProductSupplier? @relation(fields: [productSupplierId], references: [id], onDelete: SetNull)
  supplierId        String?          @db.Uuid
  supplier          Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // --- Momentopname bij aanmaak. Een latere productwijziging raakt dit niet.
  productArticleNumber String?
  productName          String
  variantDescription   String?
  supplierName         String?
  description          String?

  quantity          Int
  unitSalePrice     Decimal @db.Decimal(14, 4)
  unitPurchasePrice Decimal @default(0) @db.Decimal(14, 4)
  discountPercent   Decimal @default(0) @db.Decimal(5, 2)
  setupCost         Decimal @default(0) @db.Decimal(14, 4)
  vatRate           Decimal @default(21) @db.Decimal(5, 2)

  /// Afgeronde regelbedragen. Btw per regel op twee decimalen (ADR-0005);
  /// het ordertotaal is de som van deze afgeronde bedragen.
  lineSubtotalExclVat Decimal @default(0) @db.Decimal(14, 2)
  lineVatAmount       Decimal @default(0) @db.Decimal(14, 2)
  lineTotalInclVat    Decimal @default(0) @db.Decimal(14, 2)
  linePurchaseTotal   Decimal @default(0) @db.Decimal(14, 2)
  lineMarginAmount    Decimal @default(0) @db.Decimal(14, 2)

  /// Statussen staan per regel: een order kan regel 1 geleverd en regel 3
  /// wachtend op drukproef hebben. De order toont een samenvatting.
  proofStatus     ProofStatus     @default(NOT_REQUIRED)
  purchaseStatus  PurchaseStatus  @default(NOT_ORDERED)
  logisticsStatus LogisticsStatus @default(NONE)

  expectedDeliveryDate DateTime?
  notes                String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  printJobs          OrderLinePrintJob[]
  events             OrderEvent[]
  documents          Document[]
  proofs             Proof[]
  purchaseOrderLines PurchaseOrderLine[]

  shipmentItems ShipmentItem[]

  @@unique([orderId, lineNumber])
  @@index([orderId])
  @@index([supplierId])
  @@index([proofStatus])
  @@index([purchaseStatus])
  @@index([logisticsStatus])
  @@map("order_lines")
}

model OrderLinePrintJob {
  id          String    @id @default(uuid()) @db.Uuid
  orderLineId String    @db.Uuid
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  printMethodId String?      @db.Uuid
  printMethod   PrintMethod? @relation(fields: [printMethodId], references: [id], onDelete: SetNull)

  /// Ook de techniek is een momentopname: naam blijft bewaard als de
  /// genormaliseerde techniek later wijzigt.
  printMethodName String
  position        String?
  colors          Int     @default(1)
  unitPrice       Decimal @default(0) @db.Decimal(14, 4)
  setupCost       Decimal @default(0) @db.Decimal(14, 4)
  notes           String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Genormaliseerde positie. `position` blijft de momentopname van de tekst.
  printPositionId String?        @db.Uuid
  printPosition   PrintPosition? @relation(fields: [printPositionId], references: [id], onDelete: SetNull)

  @@index([orderLineId])
  @@map("order_line_print_jobs")
}

/// Append-only tijdlijn. Gebeurtenissen worden nooit gewijzigd of verwijderd.
model OrderEvent {
  id          String     @id @default(uuid()) @db.Uuid
  orderId     String     @db.Uuid
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLineId String?    @db.Uuid
  orderLine   OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  type            OrderEventType
  statusDimension StatusDimension?
  fromValue       String?
  toValue         String?

  /// Leeg bij een gebeurtenis die door een achtergrondtaak is veroorzaakt.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())
  note       String?
  payload    Json?

  @@index([orderId, occurredAt])
  @@index([orderLineId])
  @@map("order_events")
}

// --- Documenten ------------------------------------------------------------

model Document {
  id         String             @id @default(uuid()) @db.Uuid
  category   DocumentCategory
  title      String
  /// INTERNAL blijft onzichtbaar in het klantportaal.
  visibility DocumentVisibility @default(INTERNAL)

  customerId  String?    @db.Uuid
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId     String?    @db.Uuid
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLineId String?    @db.Uuid
  orderLine   OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  shipmentId        String?          @db.Uuid
  shipment          Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  quoteId           String?          @db.Uuid
  quote             Quote?           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteVersionId    String?          @db.Uuid
  quoteVersion      QuoteVersion?    @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  proofId           String?          @db.Uuid
  proof             Proof?           @relation(fields: [proofId], references: [id], onDelete: Cascade)
  purchaseOrderId   String?          @db.Uuid
  purchaseOrder     PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseInvoiceId String?          @db.Uuid
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions DocumentVersion[]

  @@index([customerId])
  @@index([orderId])
  @@index([category])
  @@index([quoteId])
  @@index([quoteVersionId])
  @@index([shipmentId])
  @@index([proofId])
  @@index([purchaseOrderId])
  @@index([purchaseInvoiceId])
  @@map("documents")
}

model DocumentVersion {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  versionNumber Int
  storageKey    String @unique
  fileName      String
  mimeType      String
  sizeBytes     Int
  checksum      String

  uploadedById String?  @db.Uuid
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime @default(now())
  note         String?

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

// --- Taken en samenwerking -------------------------------------------------

model Task {
  id          String  @id @default(uuid()) @db.Uuid
  title       String
  description String?

  assigneeId  String? @db.Uuid
  assignee    User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String? @db.Uuid
  createdBy   User?   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  orderId    String?   @db.Uuid
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quoteId    String?   @db.Uuid
  quote      Quote?    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  dueDate     DateTime?
  priority    TaskPriority @default(NORMAL)
  status      TaskStatus   @default(OPEN)
  completedAt DateTime?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId, status])
  @@index([orderId])
  @@index([quoteId])
  @@index([dueDate])
  @@map("tasks")
}

// --- Systeem ---------------------------------------------------------------

/// Uitgifte van unieke nummers onder een rij-lock. Formaat en startwaarde zijn
/// instelbaar, ook nadat er nummers zijn uitgegeven, zodat bestaande reeksen
/// uit Teamleader voortgezet kunnen worden (ADR-0005).
model NumberSequence {
  id   String @id @default(uuid()) @db.Uuid
  key  String
  /// 0 voor reeksen die niet per jaar lopen, zoals klantnummers.
  year Int    @default(0)

  /// Plaatshouders: {year} en {counter:n} voor n cijfers met voorloopnullen.
  format    String
  lastValue Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([key, year])
  @@map("number_sequences")
}

model VatRate {
  id         String  @id @default(uuid()) @db.Uuid
  code       String  @unique
  name       String
  percentage Decimal @db.Decimal(5, 2)
  isDefault  Boolean @default(false)
  isActive   Boolean @default(true)

  @@map("vat_rates")
}

/// Instellingen die zonder migratie te wijzigen moeten zijn, zoals
/// vat.rounding en de standaard btw-code.
/// Soort sjabloon; bepaalt welke velden erin gebruikt mogen worden.
enum TemplateKind {
  /// Tekst boven de offerteregels.
  QUOTE_INTRO
  /// Voorwaarden en afsluiting onder de offerteregels.
  QUOTE_TERMS
  /// Omschrijving van één offerteregel; kent de productvelden.
  QUOTE_LINE
  /// Onderwerp en tekst van de e-mail waarmee een offerte verstuurd wordt.
  QUOTE_EMAIL
}

/// Een tekstsjabloon met dynamische velden.
///
/// Staat in de database en niet in de code: de teksten op een offerte en in
/// een e-mail zijn van de opdrachtgever, niet van de ontwikkelaar. De velden
/// die erin mogen staan hangen af van het soort sjabloon en worden bij het
/// opslaan gecontroleerd, zodat er nooit een onbekend veld op een document
/// bij een klant belandt.
model DocumentTemplate {
  id          String       @id @default(uuid()) @db.Uuid
  key         String       @unique
  kind        TemplateKind
  name        String
  /// Waar dit sjabloon voor dient, voor in het beheerscherm.
  description String?

  /// Alleen gevuld bij een e-mailsjabloon.
  subject String?
  body    String

  /// Systeemsjablonen zijn wel aan te passen maar niet te verwijderen: de
  /// code verwijst naar hun sleutel.
  isSystem Boolean @default(false)
  isActive Boolean @default(true)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@map("document_templates")
}

model Setting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

/// Auditlog op iedere betekenisvolle handeling. Append-only.
model AuditLog {
  id       String      @id @default(uuid()) @db.Uuid
  entity   String
  entityId String
  action   AuditAction

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())
  /// Alleen de gewijzigde velden, als { veld: { van, naar } }.
  diff       Json?
  ipAddress  String?
  userAgent  String?

  @@index([entity, entityId])
  @@index([userId])
  @@index([occurredAt])
  @@map("audit_logs")
}

// ===========================================================================
// Stap 1b
// ===========================================================================

// --- Leverancierskoppelingen en staging (ADR-0004) -------------------------

enum ConnectorTransport {
  REST
  SOAP
  XML_FEED
  /// Een te downloaden JSON-bestand. Apart van XML_FEED omdat het verschil
  /// er werkelijk toe doet: PF Concept biedt beide aan en wij kozen JSON
  /// (ADR-0019), terwijl ANDA alleen XML levert.
  JSON_FEED
  CSV_FEED
  SFTP
  FTP
  /// Handmatig geupload bestand. Voor Clipper en Toppoint zolang die geen
  /// koppeling bieden; zie docs/leveranciers/koppelingen.md.
  FILE_UPLOAD
}

enum ConnectorCapability {
  CATALOG
  MEDIA
  PRICE_TIERS
  INVENTORY
  /// Bedrukposities, technieken en drukprijzen.
  PRINT_DATA
  PLACE_ORDER
  ORDER_STATUS
  SHIPPING
}

/// Eén verbinding met één leverancier via één transport. Een leverancier kan
/// meerdere verbindingen hebben: catalogus via een nachtelijke feed, voorraad
/// via een API.
model SupplierConnection {
  id         String   @id @default(uuid()) @db.Uuid
  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  /// Unieke sleutel, bijvoorbeeld "pfconcept-xml" of "anda-rest".
  key          String             @unique
  connectorKey String
  transport    ConnectorTransport
  /// Niet-geheime instellingen: basis-URL, pad, tekenset, scheidingsteken.
  config       Json               @default("{}")
  /// Versleutelde credentials. Nooit in code of .env per leverancier;
  /// ontsleutelen gebeurt met CONNECTOR_SECRET_KEY uit de omgeving.
  credentials  Bytes?

  isActive  Boolean   @default(true)
  lastRunAt DateTime?
  notes     String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  capabilities       SupplierConnectionCapability[]
  importRuns         ImportRun[]
  rawProducts        RawSupplierProduct[]
  stock              SupplierStock[]
  printTechniques    SupplierPrintTechnique[]
  printManipulations SupplierPrintManipulation[]
  printMethods       SupplierPrintMethod[]
  printPriceTiers    SupplierPrintPriceTier[]
  fieldMappings      FieldMapping[]
  valueMappings      ValueMapping[]

  @@index([supplierId])
  @@map("supplier_connections")
}

/// Capability-routing: welke verbinding levert welke capability, met welke
/// voorrang. De laagste priority onder de actieve rijen wint; de volgende is
/// de terugvaloptie.
model SupplierConnectionCapability {
  id           String             @id @default(uuid()) @db.Uuid
  connectionId String             @db.Uuid
  connection   SupplierConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  capability ConnectorCapability
  isEnabled  Boolean             @default(true)
  priority   Int                 @default(100)
  /// Cron-uitdrukking; leeg betekent alleen handmatig of op gebeurtenis.
  schedule   String?
  lastRunAt  DateTime?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, capability])
  @@index([capability, isEnabled, priority])
  @@map("supplier_connection_capabilities")
}

enum ImportRunStatus {
  PENDING
  RUNNING
  SUCCESS
  /// Afgerond, maar met fouten op regelniveau.
  PARTIAL
  FAILED
  CANCELLED
}

model ImportRun {
  id           String             @id @default(uuid()) @db.Uuid
  connectionId String             @db.Uuid
  connection   SupplierConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  capability ConnectorCapability
  status     ImportRunStatus     @default(PENDING)
  /// Bij een dry-run wordt niets toegepast; alleen de diff wordt berekend.
  dryRun     Boolean             @default(false)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  itemsSeen    Int     @default(0)
  itemsChanged Int     @default(0)
  itemsFailed  Int     @default(0)
  errorSummary String?
  log          Json?

  items         ImportItem[]
  stagedChanges StagedChange[]
  rawProducts   RawSupplierProduct[]

  @@index([connectionId, startedAt])
  @@index([status])
  @@map("import_runs")
}

enum ImportItemStatus {
  OK
  SKIPPED
  FAILED
}

/// Eén regel uit een import. Eén kapot artikel mag de hele run niet slopen.
model ImportItem {
  id          String    @id @default(uuid()) @db.Uuid
  importRunId String    @db.Uuid
  importRun   ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)

  externalId String
  status     ImportItemStatus
  message    String?

  createdAt DateTime @default(now())

  @@index([importRunId, status])
  @@map("import_items")
}

/// Ruwe leveranciersdata, onaangetast bewaard. De hash voorkomt dat
/// ongewijzigde artikelen opnieuw verwerkt worden.
/// Een drukprijslijst van een leverancier, zoals hij hem aanlevert.
///
/// Niet omgerekend naar onze eigen staffels, want dat kan niet: twee van de
/// vijf prijstypes van midocean hangen af van het oppervlak van het logo, en
/// dat is pas bekend op het moment dat er gecalculeerd wordt. Daarom staat de
/// structuur hier zoals de leverancier hem geeft en rekent de calculator hem
/// uit. Zie ADR-0016.
model SupplierPrintTechnique {
  id           String             @id @default(uuid()) @db.Uuid
  connectionId String             @db.Uuid
  connection   SupplierConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  /// Techniekcode van de leverancier, bijvoorbeeld S2, TD1, DPT.
  code String
  /// Naam in het Nederlands waar de leverancier die geeft.
  name String

  /// NumberOfPositions, NumberOfColours, AreaRange, ColourAreaRange of Area.
  pricingType             String
  setup                   Decimal? @db.Decimal(14, 4)
  setupRepeat             Decimal? @db.Decimal(14, 4)
  /// Of vanaf de tweede kleur een eigen prijs geldt.
  nextColourCostIndicator Boolean  @default(false)

  /// De staffels per oppervlaktebereik, zoals de leverancier ze aanlevert.
  varCosts Json

  validFrom  DateTime?
  validUntil DateTime?
  fetchedAt  DateTime  @default(now())

  @@unique([connectionId, code])
  @@map("supplier_print_techniques")
}

/// Handlingprijs per stuk, per manipulatiecode van de leverancier.
/// De kop bij één drukcode van een leverancier die zijn drukprijzen als
/// opzoektabel levert.
///
/// Staat naast `SupplierPrintTechnique` en niet in plaats daarvan: midocean
/// en ANDA geven een prijs*structuur* die pas bij het calculeren uit te
/// rekenen is (ADR-0016), PF Concept geeft een tabel (ADR-0019). Eén model
/// voor allebei zou betekenen dat de ene leverancier zich voordoet als de
/// andere, en zo krijg je verkeerde prijzen.
model SupplierPrintMethod {
  id           String             @id @default(uuid()) @db.Uuid
  connectionId String             @db.Uuid
  connection   SupplierConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  /// Drukcode van de leverancier, bijvoorbeeld DEB02.
  printCode   String
  description String?
  /// Toeslag bij bedrukken onder het minimum bedrukkingsaantal van het
  /// artikel. Zonder deze toeslag is een kleine bedrukte oplage te goedkoop.
  ltmCharge   Decimal? @db.Decimal(14, 4)
  /// Waarvan de prijs afhangt, in de woorden van de leverancier. Bewust ruwe
  /// tekst: welke waarden PF Concept hier gebruikt is nog niet bevestigd.
  priceDependence String?
  currency        String  @default("EUR")

  fetchedAt DateTime @default(now())

  tiers SupplierPrintPriceTier[]

  @@unique([connectionId, printCode])
  @@map("supplier_print_methods")
}

/// Eén regel uit zo'n opzoektabel: bij dit formaat, dit aantal kleuren en
/// vanaf dit aantal stuks kost bedrukken dit.
model SupplierPrintPriceTier {
  id           String             @id @default(uuid()) @db.Uuid
  connectionId String             @db.Uuid
  connection   SupplierConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  methodId String              @db.Uuid
  method   SupplierPrintMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  /// Oppervlak waarvoor deze regel geldt; 0 betekent: formaat doet niet mee.
  logoSizeCm2 Decimal @default(0) @db.Decimal(10, 2)
  /// Aantal kleuren; 0 betekent: aantal kleuren doet niet mee (fullcolour).
  colors      Int     @default(0)
  /// Ondergrens, net als onze eigen staffels. Geen gesloten bereik.
  minQuantity Int
  unitPrice   Decimal @db.Decimal(14, 4)
  setupCost   Decimal @default(0) @db.Decimal(14, 4)

  fetchedAt DateTime @default(now())

  @@unique([methodId, logoSizeCm2, colors, minQuantity])
  @@index([connectionId])
  @@map("supplier_print_price_tiers")
}

model SupplierPrintManipulation {
  id           String             @id @default(uuid()) @db.Uuid
  connectionId String             @db.Uuid
  connection   SupplierConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  code          String
  description   String?
  pricePerPiece Decimal @db.Decimal(14, 4)

  fetchedAt DateTime @default(now())

  @@unique([connectionId, code])
  @@map("supplier_print_manipulations")
}

/// Voorraadstand zoals een leverancier die laatst meldde.
///
/// Dit is geen catalogusgegeven maar een meting met een tijdstip: het zegt
/// niets over wat een product *is*, alleen wat er op dat moment lag. Daarom
/// gaat voorraad niet door de beoordeling van `staged_changes` heen maar
/// rechtstreeks hierheen - zie ADR-0015. Onze eigen gegevens worden er nooit
/// door overschreven, want deze tabel bevat uitsluitend wat de leverancier zei.
model SupplierStock {
  id           String             @id @default(uuid()) @db.Uuid
  connectionId String             @db.Uuid
  connection   SupplierConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  /// Variantnummer bij de leverancier.
  sku String

  /// De eigen variant, als we het artikel hebben. Leeg betekent: de
  /// leverancier meldt voorraad van iets dat niet in onze catalogus staat.
  /// SetNull, want het verwijderen van een variant mag een meting niet
  /// meeslepen.
  variantId String?         @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  quantity Int

  /// De eerstvolgende twee verwachte leveringen, als de leverancier die geeft.
  firstArrivalDate     DateTime?
  firstArrivalQuantity Int?
  nextArrivalDate      DateTime?
  nextArrivalQuantity  Int?

  /// Wanneer wij dit ophaalden. Een voorraadstand zonder tijdstip is waardeloos.
  fetchedAt DateTime @default(now())

  @@unique([connectionId, sku])
  @@index([variantId])
  @@map("supplier_stock")
}

model RawSupplierProduct {
  id           String             @id @default(uuid()) @db.Uuid
  connectionId String             @db.Uuid
  connection   SupplierConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  externalId String
  payload    Json
  /// SHA-256 over de gecanoniseerde payload.
  hash       String
  fetchedAt  DateTime @default(now())

  importRunId String?    @db.Uuid
  importRun   ImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)

  @@unique([connectionId, externalId])
  @@index([hash])
  @@map("raw_supplier_products")
}

model FieldMapping {
  id           String             @id @default(uuid()) @db.Uuid
  connectionId String             @db.Uuid
  connection   SupplierConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  /// Pad in de ruwe payload, bijvoorbeeld "product.descriptions.nl".
  sourcePath  String
  /// Veld in de eigen catalogus, bijvoorbeeld "name".
  targetField String
  /// Optionele bewerking: trim, upper, parseDecimal, splitList.
  transform   String?
  isActive    Boolean @default(true)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, targetField, sourcePath])
  @@map("field_mappings")
}

enum MappingDomain {
  CATEGORY
  COLOR
  SIZE
  PRINT_METHOD
  PRINT_POSITION
  UNIT
  CURRENCY
}

/// Externe systemen waarmee herkomst en synchronisatie worden bijgehouden.
enum ExternalSystem {
  TEAMLEADER
  SNELSTART
  MOLLIE
  MICROSOFT_GRAPH
  SUPPLIER
  PROMOHOUSE
  OTHER
}

enum ShipmentMethod {
  /// Leverancier levert rechtstreeks bij de klant af.
  SUPPLIER_DIRECT
  /// Wij verzenden zelf, eventueel na ontvangst in eigen huis.
  OWN_SHIPMENT
}

enum ShipmentStatus {
  DRAFT
  READY
  SHIPPED
  DELIVERED
  FAILED
  CANCELLED
}

/// Waardemapping: "navy", "NY" en "donkerblauw" naar één eigen waarde.
/// Zonder deze laag is leveranciersdata onbruikbaar naast elkaar.
model ValueMapping {
  id           String             @id @default(uuid()) @db.Uuid
  connectionId String             @db.Uuid
  connection   SupplierConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  domain      MappingDomain
  sourceValue String
  targetValue String
  /// Verwijzing naar de eigen entiteit (categorie, bedrukkingstechniek).
  targetId    String?       @db.Uuid

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, domain, sourceValue])
  @@index([domain])
  @@map("value_mappings")
}

enum StagedChangeType {
  CREATE
  UPDATE
  DELETE
}

enum StagedChangeStatus {
  PENDING
  APPLIED
  REJECTED
}

/// Klaargezette wijziging uit een import. Per type wijziging is instelbaar of
/// die automatisch wordt toegepast of eerst goedgekeurd moet worden.
model StagedChange {
  id          String    @id @default(uuid()) @db.Uuid
  importRunId String    @db.Uuid
  importRun   ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)

  /// Doelentiteit: Product, ProductSupplier, PurchasePriceTier, MediaAsset.
  entityType String
  entityId   String?            @db.Uuid
  externalId String?
  changeType StagedChangeType
  status     StagedChangeStatus @default(PENDING)
  /// Alleen de gewijzigde velden, als { veld: { van, naar } }.
  diff       Json

  reviewedById String?   @db.Uuid
  reviewedBy   User?     @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  appliedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([importRunId, status])
  @@index([status, entityType])
  @@map("staged_changes")
}

// --- Drukproeven (Module G) ------------------------------------------------

model Proof {
  id          String    @id @default(uuid()) @db.Uuid
  orderLineId String    @db.Uuid
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  versionNumber    Int
  status           ProofStatus @default(REQUESTED)
  requestedAt      DateTime    @default(now())
  receivedAt       DateTime?
  sentToCustomerAt DateTime?
  decidedAt        DateTime?
  notes            String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals ProofApproval[]
  documents Document[]

  @@unique([orderLineId, versionNumber])
  @@index([status])
  @@map("proofs")
}

enum ProofDecision {
  APPROVED
  CHANGES_REQUESTED
}

/// Goedkeuringshistorie. Een beslissing komt van een medewerker of, later via
/// het klantportaal, van een contactpersoon van de klant.
model ProofApproval {
  id      String @id @default(uuid()) @db.Uuid
  proofId String @db.Uuid
  proof   Proof  @relation(fields: [proofId], references: [id], onDelete: Cascade)

  decision           ProofDecision
  decidedByUserId    String?        @db.Uuid
  decidedByUser      User?          @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedByContactId String?        @db.Uuid
  decidedByContact   ContactPerson? @relation(fields: [decidedByContactId], references: [id], onDelete: SetNull)
  decidedAt          DateTime       @default(now())
  comment            String?

  isDemo Boolean @default(false)

  @@index([proofId])
  @@map("proof_approvals")
}

// --- Inkoop (Module H) -----------------------------------------------------

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  IN_PRODUCTION
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String   @id @default(uuid()) @db.Uuid
  number     String   @unique
  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  status               PurchaseOrderStatus @default(DRAFT)
  orderedAt            DateTime?
  expectedDeliveryDate DateTime?
  reference            String?
  notes                String?

  totalExclVat Decimal @default(0) @db.Decimal(14, 2)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines         PurchaseOrderLine[]
  confirmations SupplierConfirmation[]
  receipts      GoodsReceipt[]
  documents     Document[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lineNumber      Int

  /// Koppeling naar de verkoopregel waar deze inkoop voor is.
  orderLineId       String?          @db.Uuid
  orderLine         OrderLine?       @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  productSupplierId String?          @db.Uuid
  productSupplier   ProductSupplier? @relation(fields: [productSupplierId], references: [id], onDelete: SetNull)

  description       String
  quantity          Int
  /// Bijgewerkt uit de ontvangstregels; maakt deelontvangsten zichtbaar.
  quantityReceived  Int     @default(0)
  unitPurchasePrice Decimal @db.Decimal(14, 4)
  lineTotal         Decimal @default(0) @db.Decimal(14, 2)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receiptLines GoodsReceiptLine[]
  invoiceLines PurchaseInvoiceLine[]

  @@unique([purchaseOrderId, lineNumber])
  @@index([orderLineId])
  @@map("purchase_order_lines")
}

model SupplierConfirmation {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  reference            String?
  confirmedAt          DateTime  @default(now())
  expectedDeliveryDate DateTime?
  /// Ruwe bevestiging zoals ontvangen, voor herkomst en geschillen.
  payload              Json?

  isDemo Boolean @default(false)

  @@index([purchaseOrderId])
  @@map("supplier_confirmations")
}

/// Deelontvangst. Meerdere ontvangsten per inkooporder zijn normaal.
model GoodsReceipt {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  receivedAt   DateTime @default(now())
  reference    String?
  trackingCode String?
  notes        String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  lines GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String            @id @default(uuid()) @db.Uuid
  goodsReceiptId      String            @db.Uuid
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String            @db.Uuid
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)

  quantity Int
  notes    String?

  isDemo Boolean @default(false)

  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
  @@map("goods_receipt_lines")
}

// --- Inkoopfacturen (Module I: voorbereid, nog niet gebouwd) ---------------

enum PurchaseInvoiceStatus {
  RECEIVED
  MATCHED
  CONTENT_APPROVED
  FINANCE_APPROVED
  DISPUTED
  BOOKED
  REJECTED
}

/// Bouwen we later. Het model staat er nu zodat de FK-richting vastligt en de
/// factuurmodule niets hoeft te breken. Geen boekhoudkoppeling.
model PurchaseInvoice {
  id         String   @id @default(uuid()) @db.Uuid
  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  invoiceNumber String
  invoiceDate   DateTime
  dueDate       DateTime?
  currency      String    @default("EUR")

  totalExclVat Decimal @default(0) @db.Decimal(14, 2)
  vatAmount    Decimal @default(0) @db.Decimal(14, 2)
  totalInclVat Decimal @default(0) @db.Decimal(14, 2)

  status PurchaseInvoiceStatus @default(RECEIVED)

  /// Gevuld als deze factuur een dubbele is van een eerdere.
  duplicateOfId String?           @db.Uuid
  duplicateOf   PurchaseInvoice?  @relation("InvoiceDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    PurchaseInvoice[] @relation("InvoiceDuplicate")

  contentApprovedById String?   @db.Uuid
  contentApprovedBy   User?     @relation("InvoiceContentApprover", fields: [contentApprovedById], references: [id], onDelete: SetNull)
  contentApprovedAt   DateTime?
  financeApprovedById String?   @db.Uuid
  financeApprovedBy   User?     @relation("InvoiceFinanceApprover", fields: [financeApprovedById], references: [id], onDelete: SetNull)
  financeApprovedAt   DateTime?
  bookedAt            DateTime?

  /// Ruwe bron: uitgelezen PDF- of UBL-inhoud.
  sourcePayload Json?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines     PurchaseInvoiceLine[]
  documents Document[]

  /// Dubbele facturen signaleren: dezelfde leverancier kan hetzelfde
  /// factuurnummer niet twee keer hebben.
  @@unique([supplierId, invoiceNumber])
  @@index([status])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id                String          @id @default(uuid()) @db.Uuid
  purchaseInvoiceId String          @db.Uuid
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  purchaseOrderLineId String?            @db.Uuid
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)

  description String
  quantity    Decimal @db.Decimal(14, 4)
  unitPrice   Decimal @db.Decimal(14, 4)
  vatRate     Decimal @default(21) @db.Decimal(5, 2)
  lineTotal   Decimal @default(0) @db.Decimal(14, 2)

  isDemo Boolean @default(false)

  @@index([purchaseInvoiceId])
  @@map("purchase_invoice_lines")
}

// --- Kanalen, prijsregels en partners (ADR-0004, uitgaande kant) -----------

enum ChannelType {
  /// Eigen publieke webshop.
  PUBLIC
  /// Besloten omgeving van één klant (Module K).
  CUSTOMER
  /// Partnerkanaal: wederverkoper, marktplaats of affiliate.
  PARTNER
}

model ShopChannel {
  id   String      @id @default(uuid()) @db.Uuid
  key  String      @unique
  name String
  type ChannelType

  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)
  settings Json    @default("{}")

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assortment      ChannelAssortmentItem[]
  priceRules      PriceRule[]
  feedExports     FeedExport[]
  partnerAccounts PartnerAccount[]

  @@index([type])
  @@map("shop_channels")
}

model ChannelAssortmentItem {
  id        String      @id @default(uuid()) @db.Uuid
  channelId String      @db.Uuid
  channel   ShopChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  productId String      @db.Uuid
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  isVisible         Boolean  @default(true)
  sort              Int      @default(0)
  /// Vaste prijs die de prijsregels overschrijft.
  overrideUnitPrice Decimal? @db.Decimal(14, 4)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([channelId, productId])
  @@index([channelId, isVisible])
  @@map("channel_assortment_items")
}

/// Waarop het percentage van een margeregel slaat. Deze twee worden in deze
/// handel het vaakst door elkaar gehaald: 40% marge op de verkoopprijs is een
/// opslag van 66,7% op de inkoop. Een regel zegt daarom zelf welke hij bedoelt
/// in plaats van dat je het uit het getal moet raden.
enum PriceRuleMarginBasis {
  /// Opslag op de inkoopprijs: 110 betekent keer 2,1.
  COST
  /// Marge als deel van de verkoopprijs: 40 betekent inkoop / 0,6.
  SALE
}

enum PriceRuleScope {
  GLOBAL
  SUPPLIER
  CATEGORY
  PRODUCT
  CUSTOMER
  CHANNEL
}

/// Declaratieve margeregels. Eén prijsengine bedient het orderscherm, de
/// webshop en de partnerfeeds (ADR-0005). Regels zijn geldig binnen een
/// periode, zodat een verhoging vooruit klaargezet kan worden.
model PriceRule {
  id    String         @id @default(uuid()) @db.Uuid
  scope PriceRuleScope

  supplierId String?          @db.Uuid
  supplier   Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId String?          @db.Uuid
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productId  String?          @db.Uuid
  product    Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?          @db.Uuid
  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channelId  String?          @db.Uuid
  channel    ShopChannel?     @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// Vanaf welk aantal deze regel geldt.
  minQuantity   Int      @default(1)
  /// Waarop `marginPercent` en `printMarginPercent` slaan. COST houdt het
  /// gedrag van bestaande regels, die als opslag op de inkoop bedoeld waren.
  marginBasis PriceRuleMarginBasis @default(COST)

  /// Percentage op de inkoopprijs, of een vast opslagbedrag.
  marginPercent Decimal? @db.Decimal(6, 2)
  markupAmount  Decimal? @db.Decimal(14, 4)
  /// Marge op bedrukking en instelkosten. Leeg betekent: dezelfde marge als
  /// op het artikel, zodat drukwerk nooit stilzwijgend zonder marge meegaat.
  printMarginPercent Decimal? @db.Decimal(6, 2)

  /// Waarvoor deze regel bedoeld is, voor wie hem later terugleest.
  note String?

  /// Lagere waarde wint bij gelijke specificiteit.
  priority  Int       @default(100)
  validFrom DateTime?
  validTo   DateTime?
  isActive  Boolean   @default(true)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, isActive, priority])
  @@index([productId])
  @@index([customerId])
  @@map("price_rules")
}

enum FeedFormat {
  CSV
  XML
  JSON
  GOOGLE_SHOPPING
}

model FeedExport {
  id        String      @id @default(uuid()) @db.Uuid
  channelId String      @db.Uuid
  channel   ShopChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  key      String     @unique
  name     String
  format   FeedFormat
  isActive Boolean    @default(true)
  settings Json       @default("{}")

  lastGeneratedAt DateTime?
  storageKey      String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channelId])
  @@map("feed_exports")
}

model PartnerAccount {
  id   String @id @default(uuid()) @db.Uuid
  name String

  channelId String?      @db.Uuid
  channel   ShopChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  contactEmail String?
  isActive     Boolean @default(true)
  notes        String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys ApiKey[]

  @@map("partner_accounts")
}

/// Alleen de hash van de sleutel wordt bewaard; de sleutel zelf is na
/// aanmaken niet meer op te vragen.
model ApiKey {
  id   String @id @default(uuid()) @db.Uuid
  name String

  partnerAccountId String?         @db.Uuid
  partnerAccount   PartnerAccount? @relation(fields: [partnerAccountId], references: [id], onDelete: Cascade)

  keyHash String   @unique
  /// Permissies in dezelfde module:actie-vorm als bij gebruikers.
  scopes  String[] @default([])

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([partnerAccountId])
  @@map("api_keys")
}

// ===========================================================================
// Taak 2: herkomst, uitgaande leveringen en bedrukposities
// ===========================================================================

/// Genormaliseerde bedrukpositie. Meerdere bedrukkingen per orderregel konden
/// al via meerdere print jobs; wat ontbrak was de positie als entiteit, nodig
/// om leveranciersbenamingen te mappen (MappingDomain.PRINT_POSITION) en om
/// op positie te kunnen filteren en rapporteren.
model PrintPosition {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  name        String
  description String?
  sort        Int     @default(0)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productOptions     ProductPrintOption[]
  orderLinePrintJobs OrderLinePrintJob[]
  quoteItemPrintJobs QuoteItemPrintJob[]

  @@map("print_positions")
}

/// Herkomst en synchronisatiesleutel richting externe systemen.
///
/// Nodig voor twee dingen tegelijk: de Teamleader-migratie moet herleidbaar
/// zijn, en elke synchronisatie met SnelStart, Mollie of Graph moet idempotent
/// zijn. Zonder deze tabel levert een mislukte synchronisatie bij de tweede
/// poging een duplicaat.
///
/// Bewust polymorf: `entityType` plus `entityId` in plaats van een kolom per
/// entiteit. Dat kost referentiële integriteit - er is geen foreign key - maar
/// het alternatief is vijftien nullable kolommen die bij elke nieuwe entiteit
/// weer groeien. De prijs is een opruimtaak voor verwijsrijen zonder doel;
/// dat staat als aandachtspunt in docs/DATABASE.md.
model ExternalReference {
  id     String         @id @default(uuid()) @db.Uuid
  system ExternalSystem

  /// Naam van het interne model, bijvoorbeeld "Customer" of "PurchaseInvoice".
  entityType String
  entityId   String @db.Uuid

  /// Identificatie bij het externe systeem.
  externalId     String
  /// Leesbaar kenmerk, bijvoorbeeld een SnelStart-factuurnummer.
  externalNumber String?

  /// Laatst bekende externe toestand, voor onderzoek bij verschillen.
  payload      Json?
  lastSyncedAt DateTime?
  lastError    String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Eén extern record wijst naar maximaal één intern record per systeem.
  @@unique([system, entityType, externalId])
  /// En omgekeerd: geen twee externe identificaties voor hetzelfde interne
  /// record binnen één systeem.
  @@unique([system, entityType, entityId])
  @@index([entityType, entityId])
  @@map("external_references")
}

/// Uitgaande zending naar de klant.
///
/// Niet te verwarren met `goods_receipts`, dat inkomend is: wat de leverancier
/// bij ons of bij de klant aflevert. Een order kan meerdere zendingen hebben,
/// naar verschillende adressen, op verschillende momenten.
model Shipment {
  id      String @id @default(uuid()) @db.Uuid
  number  String @unique
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  deliveryAddressId String?  @db.Uuid
  deliveryAddress   Address? @relation("ShipmentDeliveryAddress", fields: [deliveryAddressId], references: [id], onDelete: SetNull)

  method ShipmentMethod @default(OWN_SHIPMENT)
  status ShipmentStatus @default(DRAFT)

  /// Gevuld bij een rechtstreekse levering vanuit de leverancier.
  supplierId String?   @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  carrier      String?
  trackingCode String?
  trackingUrl  String?

  plannedShipDate      DateTime?
  shippedAt            DateTime?
  expectedDeliveryDate DateTime?
  deliveredAt          DateTime?

  recipientName String?
  notes         String?

  /// Teller voor optimistic locking.
  version Int @default(0)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     ShipmentItem[]
  documents Document[]

  @@index([orderId])
  @@index([status])
  @@index([trackingCode])
  @@map("shipments")
}

/// Wat er in een zending zit, per orderregel. Meerdere zendingen kunnen
/// dezelfde orderregel deels bevatten; de som bepaalt of de regel volledig
/// geleverd is.
model ShipmentItem {
  id          String    @id @default(uuid()) @db.Uuid
  shipmentId  String    @db.Uuid
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderLineId String    @db.Uuid
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  quantity Int
  notes    String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  /// Eén regel komt per zending maximaal één keer voor; een tweede partij van
  /// dezelfde regel is een tweede zending.
  @@unique([shipmentId, orderLineId])
  @@index([orderLineId])
  @@map("shipment_items")
}

// --- Authenticatie (better-auth, ADR-0012) ---------------------------------
// Vorm en veldnamen liggen vast door de bibliotheek; gecontroleerd met
// `better-auth generate`. Alleen de tabelnamen en het UUID-type op userId zijn
// van ons, zodat ze aansluiten op de rest van het schema.

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("auth_sessions")
}

/// Draagt de wachtwoordhash voor e-mail-en-wachtwoord, en later de gegevens
/// van een externe aanbieder.
model Account {
  id         String @id
  accountId  String
  providerId String

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("auth_accounts")
}

/// Kortlevende codes: e-mailverificatie, wachtwoordherstel.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

/// TOTP-geheim en herstelcodes. `lockedUntil` remt brute force op de code af.
model TwoFactor {
  id          String @id
  secret      String
  backupCodes String

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("auth_two_factors")
}
