{
  "name": "@rgh/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- node --watch-path=./src -r @swc-node/register src/main.ts",
    "start": "dotenv -e ../../.env -- node -r @swc-node/register src/main.ts",
    "test": "node ../../scripts/prepare-test-db.mjs && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed:accounts": "dotenv -e ../../.env -- node -r @swc-node/register scripts/seed-accounts.ts",
    "connection:credentials": "dotenv -e ../../.env -- node -r @swc-node/register scripts/set-connection-credentials.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@rgh/contracts": "*",
    "@rgh/db": "*",
    "better-auth": "^1.7.14",
    "fast-xml-parser": "^5.11.2",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@nestjs/testing": "^12.3.2",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "supertest": "^7.3.1",
    "unplugin-swc": "^2.0.0"
  }
}
