{
  "name": "relatiegeschenken-hub",
  "private": true,
  "version": "0.0.0",
  "description": "ERP/CRM voor relatiegeschenken, promotionele artikelen en bedrukte producten",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:guard": "node scripts/db-guard.mjs",
    "db:migrate": "npm run migrate -w @rgh/db",
    "db:seed": "npm run seed -w @rgh/db",
    "db:studio": "npm run studio -w @rgh/db",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w @rgh/api",
    "api:dev": "npm run dev -w @rgh/api"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
